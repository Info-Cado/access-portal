{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Access Portal",
  "version": "0.2.6",
  "identifier": "com.accessportal.admin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node scripts/fetch-cloudflared.mjs && npm run ui:dev",
    "beforeBuildCommand": "node scripts/fetch-cloudflared.mjs && npm run ui:build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Access Portal",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/cloudflared"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyRkUxRjBGQ0NBOTQ5MTEKUldRUlNhbk1EeC8rUWxqSkx3Qy9BeW5QSWVJbnVKSHNLajRwOHpPQkVoai9VSnF1MUZGZi84RTUK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
