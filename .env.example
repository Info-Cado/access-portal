# Every setting the portal understands. The app reads them from
# C:\ProgramData\AccessPortal\portal.env (created on first start); copy the ones
# you want to change there and restart the app.

# Database location. Default: portal.db in the data folder.
# DATABASE_URL=sqlite://C:/ProgramData/AccessPortal/portal.db?mode=rwc

# Address the public link (and any reverse proxy) connects to (plain HTTP,
# loopback). With Settings -> Without the internet switched on, the portal also
# serves HTTPS on the computer's other addresses (local network, Tailscale) on
# TLS_PORT with a self-signed certificate; see src/network.rs.
BIND_ADDR=127.0.0.1:8088
# TLS_PORT=8443

# REQUIRED. Any long random string. Used to encrypt stored Windows passwords.
# If you change it, previously stored Windows passwords can no longer be decrypted.
PORTAL_SECRET=change-me-to-a-long-random-string

# Folder holding one transfer folder per user. Sessions see their folder as the
# drive \\tsclient\P, and the browser uploads to and downloads from it.
# Default: files\ in the data folder.
# FILES_DIR=C:\ProgramData\AccessPortal\files

# Largest single file a browser may upload, in megabytes.
MAX_UPLOAD_MB=2048

# Session resolution. A fixed size is scaled to fit the browser window;
# "auto" makes the session follow the window size instead.
SESSION_SIZE=1920x1080

# Motion hybrid: areas that keep changing (scrolling, dragging) are sent as H.264
# video instead of images; still areas stay crisp tiles. Only used when the
# browser can decode H.264. Set VIDEO=off to always use tiles.
VIDEO=on

# Direct peer-to-peer link between the browser and this machine (WebRTC).
# Falls back to a WebSocket automatically. Set P2P=off to disable.
P2P=on
# Comma-separated STUN/TURN servers used to find a direct path. Behind strict
# NATs a TURN relay is needed; give its credentials below.
ICE_SERVERS=stun:stun.l.google.com:19302
ICE_USERNAME=
ICE_CREDENTIAL=

# Session + lockout tuning.
SESSION_TTL_SECS=28800
MAX_FAILED=5
LOCKOUT_SECS=300

# Set to true once you serve the portal over HTTPS.
COOKIE_SECURE=false
